@@ -0,0 +1,83 @@
+/** Memory A/B display data only; never add this object to provider messages. */
+export type ArenaPayload = {
+	version: 1;
+	trial_id: string;
+	fairness: 'BEST_EFFORT_PRE_TURN';
+	main: {
+		status: string; retrieval_status: string; retrieval_ms: number | null;
+		generation_ms: number | null; evidence: { message_id: number; text: string }[];
+	};
+	shadow: {
+		status: string; recall_status: string; reply: string | null; error_code: string | null;
+		retrieval_ms: number | null; generation_ms: number | null;
+		evidence: { source_id: string; text: string }[];
+	};
+	evaluation: { status: string; votable: boolean };
+};
+
+export const arenaMetadata = (enabled = false) =>
+	enabled === true ? { metadata: { corvus_arena: true } } : {};
+
+const record = (v: any) => v !== null && typeof v === 'object' && !Array.isArray(v);
+const keys = (v: any, expected: string[]) => record(v) &&
+	Object.keys(v).sort().join(',') === [...expected].sort().join(',');
+const text = (v: any) => typeof v === 'string' && v.length <= 200000;
+const elapsed = (v: any) => v === null || (typeof v === 'number' && Number.isFinite(v) && v >= 0);
+const evidence = (rows: any, shadow = false) => Array.isArray(rows) && rows.length <= 100 &&
+	rows.every((r) => keys(r, [shadow ? 'source_id' : 'message_id', 'text']) && text(r.text) &&
+		(shadow ? typeof r.source_id === 'string' && /^hindsight:.{1,256}$/.test(r.source_id)
+			: Number.isInteger(r.message_id) && r.message_id > 0));
+
+export function validArenaPayload(v: any): v is ArenaPayload {
+	if (!keys(v, ['version', 'trial_id', 'fairness', 'main', 'shadow', 'evaluation'])) return false;
+	if (v.version !== 1 || !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/.test(v.trial_id) ||
+		v.fairness !== 'BEST_EFFORT_PRE_TURN') return false;
+	const m = v.main, s = v.shadow, e = v.evaluation;
+	return keys(m, ['status', 'retrieval_status', 'retrieval_ms', 'generation_ms', 'evidence']) &&
+		['OK', 'DEGRADED'].includes(m.status) && ['OK', 'ERROR', 'EMPTY'].includes(m.retrieval_status) &&
+		elapsed(m.retrieval_ms) && elapsed(m.generation_ms) && evidence(m.evidence) &&
+		keys(s, ['status', 'recall_status', 'reply', 'error_code', 'retrieval_ms', 'generation_ms', 'evidence']) &&
+		['OK', 'ERROR', 'SKIPPED'].includes(s.status) && ['OK', 'ERROR'].includes(s.recall_status) &&
+		(s.reply === null || text(s.reply)) && (s.status !== 'OK' || (text(s.reply) && !!s.reply.trim())) &&
+		[null, 'HINDSIGHT_RECALL_UNAVAILABLE', 'CANONICAL_CONTEXT_UNAVAILABLE', 'SHADOW_GENERATION_FAILED',
+			'CANONICAL_TURN_FAILED', 'COMPARISON_UNAVAILABLE'].includes(s.error_code) &&
+		elapsed(s.retrieval_ms) && elapsed(s.generation_ms) && evidence(s.evidence, true) &&
+		keys(e, ['status', 'votable']) && ['STORED', 'UNAVAILABLE'].includes(e.status) &&
+		typeof e.votable === 'boolean' && (!e.votable || (e.status === 'STORED' && s.status === 'OK'));
+}
+
+export function acceptArenaEvent(history: any, event: any, chatId: string): boolean {
+	if (event?.data?.type !== 'corvus:arena:v1' || event.chat_id !== chatId ||
+		typeof event.message_id !== 'string' || !validArenaPayload(event.data.data)) return false;
+	const message = history.messages[event.message_id];
+	if (!message || message.role !== 'assistant' || message.model !== 'corvus_pipe' ||
+		message.corvus_arena_requested !== true || message.corvus_arena) return false;
+	if (Object.values(history.messages).some((m: any) => m.corvus_arena?.trial_id === event.data.data.trial_id)) return false;
+	message.corvus_arena = JSON.parse(JSON.stringify(event.data.data));
+	return true;
+}
+
+/** Completion callbacks can hold an older message object across an await. */
+export function preserveArena(message: any, latest: any) {
+	if (latest?.corvus_arena) message.corvus_arena = latest.corvus_arena;
+	if (latest?.corvus_arena_requested) message.corvus_arena_requested = true;
+	return message;
+}
+
+export const hasArena = (history: any) => Object.values(history?.messages ?? {})
+	.some((m: any) => m.corvus_arena_requested || m.corvus_arena);
+
+/** Per-chat single writer, owned by Chat from component start. Failures release the queue. */
+export function createArenaSaveQueue() {
+	const tails = new Map<string, Promise<void>>();
+	return {
+		pending: (id: string) => tails.has(id),
+		save<T>(id: string, write: () => Promise<T>): Promise<T> {
+			const result = (tails.get(id) ?? Promise.resolve()).then(write);
+			const tail = result.then(() => {}, () => {});
+			tails.set(id, tail);
+			void tail.then(() => { if (tails.get(id) === tail) tails.delete(id); });
+			return result;
+		}
+	};
+}
