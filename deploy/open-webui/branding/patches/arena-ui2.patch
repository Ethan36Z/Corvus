+def persist_corvus_arena_vote(chat_id: str, message_id: str, trial_id: str,
+                              choice: str, user_id: str) -> bool:
+    """Patch one saved JSON field atomically; never replace a chat snapshot."""
+    if engine.dialect.name != "sqlite":
+        return False  # The isolated Lab installation uses SQLite.
+    prefix = f'$.history.messages."{message_id}"'
+    paths = {name: f"{prefix}.{suffix}" for name, suffix in (
+        ("vote", "corvus_arena.vote"), ("trial", "corvus_arena.trial_id"),
+        ("done", "done"), ("requested", "corvus_arena_requested"),
+        ("status", "corvus_arena.evaluation.status"),
+        ("votable", "corvus_arena.evaluation.votable"),
+        ("model", "model"), ("role", "role"))}
+    statement = text("""
+        UPDATE chat SET chat = json_set(chat, :vote, :choice), updated_at = :updated_at
+        WHERE id = :chat_id AND user_id = :user_id
+          AND json_extract(chat, :trial) = :trial_id
+          AND json_extract(chat, :done) = 1
+          AND json_extract(chat, :requested) = 1
+          AND json_extract(chat, :status) = 'STORED'
+          AND json_extract(chat, :votable) = 1
+          AND json_extract(chat, :model) = 'corvus_pipe'
+          AND json_extract(chat, :role) = 'assistant'
+    """)
+    with engine.begin() as connection:
+        result = connection.execute(statement, {**paths, "choice": choice,
+            "updated_at": int(time.time()), "chat_id": chat_id,
+            "user_id": user_id, "trial_id": trial_id})
+        return result.rowcount == 1
+
+
+@app.post("/api/chat/actions/corvus_arena_vote")
+async def corvus_arena_vote(form_data: dict, user=Depends(get_verified_user)):
+    # A fixed Action target, not a user-selected URL or a general proxy.
+    if set(form_data) != {"chat_id", "message_id", "trial_id", "choice"}:
+        raise HTTPException(status_code=422, detail="Invalid Arena vote")
+    chat_id, message_id = form_data["chat_id"], form_data["message_id"]
+    trial_id, choice = form_data["trial_id"], form_data["choice"]
+    try:
+        if not all(isinstance(v, str) and v for v in (chat_id, message_id, trial_id)):
+            raise ValueError()
+        if (str(UUID(trial_id)) != trial_id or str(UUID(message_id)) != message_id
+                or choice not in ("rag", "hindsight")):
+            raise ValueError()
+    except (ValueError, TypeError, AttributeError):
+        raise HTTPException(status_code=422, detail="Invalid Arena vote") from None
+    chat = Chats.get_chat_by_id_and_user_id(chat_id, user.id)
+    message = ((chat.chat.get("history") or {}).get("messages") or {}).get(message_id) if chat else None
+    arena = message.get("corvus_arena") if isinstance(message, dict) else None
+    if (not isinstance(arena, dict) or not isinstance(arena.get("evaluation"), dict)
+            or message.get("role") != "assistant"
+            or message.get("model") != "corvus_pipe" or message.get("done") is not True
+            or message.get("corvus_arena_requested") is not True
+            or arena.get("trial_id") != trial_id
+            or arena["evaluation"].get("status") != "STORED"
+            or (arena.get("evaluation") or {}).get("votable") is not True):
+        raise HTTPException(status_code=403, detail="Arena trial unavailable")
+    try:
+        async with httpx.AsyncClient(timeout=httpx.Timeout(10, connect=3),
+                                     follow_redirects=False, trust_env=False,
+                                     transport=httpx.AsyncHTTPTransport(retries=0)) as client:
+            response = await client.post("http://127.0.0.1:18096/api/arena/vote",
+                                         json={"trial_id": trial_id, "choice": choice})
+        response.raise_for_status()
+        result = response.json()
+        if result.get("trial_id") != trial_id or result.get("choice") != choice:
+            raise ValueError("Unexpected Arena vote response")
+    except Exception:
+        raise HTTPException(status_code=502, detail="Arena vote unavailable") from None
+    try:
+        marker_persisted = persist_corvus_arena_vote(chat_id, message_id, trial_id,
+                                                      choice, user.id)
+    except Exception:
+        marker_persisted = False
+    return {**result, "marker_persisted": marker_persisted}
+
+
