diff --git a/src/lib/corvus-arena.ts b/src/lib/corvus-arena.ts
index 3f69ac8..1674887 100644
--- a/src/lib/corvus-arena.ts
+++ b/src/lib/corvus-arena.ts
@@ -1,0 +2,2 @@
+import { WEBUI_BASE_URL } from './constants';
+
@@ -4,0 +7 @@ export type ArenaPayload = {
+	vote?: 'rag' | 'hindsight';
@@ -17,0 +21,41 @@ export type ArenaPayload = {
+export async function voteArena(token: string, chatId: string, messageId: string,
+	trialId: string, choice: 'rag' | 'hindsight') {
+	const response = await fetch(`${WEBUI_BASE_URL}/api/chat/actions/corvus_arena_vote`, {
+		method: 'POST',
+		headers: { 'Content-Type': 'application/json', authorization: `Bearer ${token}` },
+		body: JSON.stringify({ chat_id: chatId, message_id: messageId, trial_id: trialId, choice })
+	});
+	if (!response.ok) throw new Error('Arena vote unavailable');
+	const result = await response.json();
+	if (result?.trial_id !== trialId || result?.choice !== choice) throw new Error('Invalid Arena vote response');
+	return result;
+}
+
+export async function recordArenaPreference(token: string, chatId: string, messageId: string,
+	arena: ArenaPayload, history: any, choice: 'rag' | 'hindsight') {
+	const result = await voteArena(token, chatId, messageId, arena.trial_id, choice);
+	const selected = { ...arena, vote: choice };
+	if (history?.messages?.[messageId]?.corvus_arena?.trial_id === arena.trial_id) {
+		history.messages[messageId].corvus_arena = selected;
+	}
+	return { arena: selected, persisted: result.marker_persisted === true };
+}
+
+/** Copy only IDs from a successful server load/save, never retain mutable history. */
+export function arenaTrialIdsFromSavedHistory(savedHistory: any): Set<string> {
+	return new Set<string>(Object.values(savedHistory?.messages ?? {})
+		.filter((message: any) => message?.role === 'assistant' &&
+			message?.model === 'corvus_pipe' && message?.done === true &&
+			message?.corvus_arena_requested === true &&
+			message?.corvus_arena?.evaluation?.status === 'STORED' &&
+			message?.corvus_arena?.evaluation?.votable === true &&
+			typeof message?.corvus_arena?.trial_id === 'string')
+		.map((message: any) => message.corvus_arena.trial_id));
+}
+
+export function savedArenaEligible(persistedArenaTrialIds: ReadonlySet<string>,
+	arena: ArenaPayload | undefined): boolean {
+	return arena?.evaluation?.status === 'STORED' && arena.evaluation.votable === true &&
+		persistedArenaTrialIds.has(arena.trial_id);
+}
