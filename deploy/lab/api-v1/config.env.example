# Documentation only. Never source into existing Corvus services.
CORVUS_API_ENABLED=FALSE
# Replace after private operator provisioning; never commit the real key/digest file.
CORVUS_API_KEY_DIGEST_FILE=/PRIVATE/CORVUS_API/keys.sha256
CORVUS_MODEL_BASE_URL=http://127.0.0.1:8095
# Optional existing foreground registry, requires separate runtime approval.
# Logical publisher is fixed to "api"; never inherit Lab/Production publisher names.
CORVUS_API_FOREGROUND_REGISTRY_DIR=
