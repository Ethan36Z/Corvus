+def _raise_if_deferred(results: list[Any]) -> None:
+    """Defer the whole retain if any completed branch requests backpressure.
+
+    Keep the original exception with the latest admission date (input order
+    breaks ties). Log ordinary sibling errors with their tracebacks: they are
+    not erased, but cannot override foreground-safety control flow. A later
+    attempt still has to extract every uncommitted chunk successfully.
+    """
+    deferrals = [result for result in results if isinstance(result, DeferOperation)]
+    if not deferrals:
+        return
+    for index, result in enumerate(results):
+        if isinstance(result, Exception) and not isinstance(result, DeferOperation):
+            logging.getLogger(__name__).warning(
+                "Retain branch %s also failed while deferring: %s", index, result,
+                exc_info=(type(result), result, result.__traceback__),
+            )
+    raise max(deferrals, key=lambda error: error.exec_date)
@@ -2505 +2526,5 @@
-        sub_results = await asyncio.gather(*sub_tasks)
+        sub_results = await asyncio.gather(*sub_tasks, return_exceptions=True)
+        _raise_if_deferred(sub_results)
+        for result in sub_results:
+            if isinstance(result, BaseException):
+                raise result
